PROJECT_NAME="GetWorxs Platform API"
API_V1_STR="/api/v1"
SECRET_KEY="getworxs_super_secret_jwt_key_change_in_production_environment_32bytes"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (MySQL 8)
MYSQL_SERVER="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="password"
MYSQL_DB="getworxs_db"
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/getworxs_db"
ASYNC_DATABASE_URL="mysql+aiomysql://root:password@localhost:3306/getworxs_db"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"
